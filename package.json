{
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.100.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "description": "Muse Character Studio — local frontend redesign (Premium Creative Studio). React 19 + TypeScript + Tailwind CSS 4. Backend contracts are unchanged; see README.md.",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.4",
    "bun-types": "^1.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "muse-character-studio",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && tsc -p server/tsconfig.server.json --noEmit && vite build",
    "dev": "vite",
    "dev:server": "bun run server/src/http.ts",
    "dev:full": "bun run server/dev-full.ts",
    "lint:css": "echo 'Tailwind v4 is compiled by @tailwindcss/vite; run bun run build to validate theme.css'",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.server.json --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}